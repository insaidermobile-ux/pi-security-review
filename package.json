{
  "name": "pi-security-review",
  "version": "0.1.0",
  "description": "Adversarial multi-agent security review for pi: /security-review audits your branch or whole project with affirmer/challenger verification.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "security",
    "security-review",
    "vulnerability"
  ],
  "files": [
    "extensions",
    "roles",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/security-review/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}
