{
  "name": "@insaidermobile-ux/pi-security-review",
  "version": "0.2.1",
  "description": "Security review for pi. Read-only agents find vulnerabilities, separate agents challenge each attack path, and a findings store keeps results across runs.",
  "license": "MIT",
  "author": "insaidermobile-ux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insaidermobile-ux/pi-security-review.git"
  },
  "homepage": "https://github.com/insaidermobile-ux/pi-security-review#readme",
  "bugs": {
    "url": "https://github.com/insaidermobile-ux/pi-security-review/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "security",
    "security-review",
    "vulnerability"
  ],
  "files": [
    "extensions",
    "roles",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/security-review/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/insaidermobile-ux/pi-security-review/main/docs/security-review-cover.png"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
